# Python
__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Agent host artifacts
.omo/
graphify-out/

# `.agentize/` needs no rule: it is machine state and carries its own `*`.
# The policy it pairs with is `agentize.yaml` at the root, which is tracked.

# Workspace-level Markdown. This kit is public and general-purpose; a backlog
# and design drafts name the consumers that asked for each feature, so they
# live in the private agentize umbrella instead of here.
/backlog.md
/drafts/
/docs/
/tasks/

# agentize-generated rules: per-instance, never commit.
.cursor/rules/agentize.auto.generated*

# agentize-generated skills: per-instance, mount re-emits them.
.cursor/skills/agentize.auto.generated*
.opencode/skills/agentize.auto.generated*
